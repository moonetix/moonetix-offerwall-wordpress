{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "moonetix-offerwall/offerwall",
	"version": "1.0.0",
	"title": "Moonetix Offerwall",
	"category": "widgets",
	"icon": "awards",
